POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me
POSTGRES_DB=utpost

MONGO_USER=change-me
MONGO_PASSWORD=change-me

DATABASE_URL=postgres://<user>:<pw>@localhost:5433/utpost
MONGO_URL=mongodb://<user>:<pw>@localhost:27017/?authSource=admin
JWT_SECRET=utpost-dev-secret-byt-i-molnet
PORT=4000
GIT_SHA=dev
SEED_ON_START=0

API_UPSTREAM=api:4000

IMAGE_FUNCTION_URL=http://localhost:7071/api/process-image
IMAGE_FUNCTION_KEY=

# CMS (M9) – redaktionens innehåll bor i Contentful (api/src/cms/contentful.js). Utan space och delivery-nyckel
# är CMS:et avstängt: appen kör, utan notiser. Space-id:t är ingen hemlighet, nycklarna är det.
# Space ID: Settings > General settings
CONTENTFUL_SPACE_ID=
# HEMLIGHET. Settings > API keys > Content Delivery API – läser bara det som är publicerat
CONTENTFUL_DELIVERY_TOKEN=
# HEMLIGHET. Samma API key > Content Preview API – läser även utkast (redaktionens förhandsgranskning)
CONTENTFUL_PREVIEW_TOKEN=
# HEMLIGHET, personlig (Settings > CMA tokens). Bara för npm run cms:setup – appen använder den aldrig
CONTENTFUL_MANAGEMENT_TOKEN=
# Hur länge publicerade notiser svaras ur minnet innan Contentful tillfrågas igen
CMS_CACHE_SECONDS=60
# HEMLIGHET. Skickas av Contentful i headern X-Utpost-Webhook-Secret. Generera: openssl rand -hex 24. Tom = webhooken är stängd
CMS_WEBHOOK_SECRET=
