{
  "name": "utpost",
  "private": true,
  "version": "1.4.2",
  "workspaces": [
    "api",
    "web",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev --workspace=api\" \"npm run dev --workspace=web\" \"npm run dev --workspace=client\"",
    "dev:api": "npm run dev -w api",
    "dev:web": "npm run dev -w web",
    "dev:client": "npm run dev -w client",
    "lint": "npm run lint -w client",
    "format:check": "npm run format:check -w client",
    "test": "npm run test -w client",
    "build": "npm run build -w client",
    "seed": "npm run seed -w api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
